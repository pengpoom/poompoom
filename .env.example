ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password-9f74e2a6
TEST_USERNAME=test
TEST_EMAIL=test@example.com
TEST_PASSWORD=change-this-user-password-4c28b1d0
APP_SESSION_TTL_HOURS=24
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=image-studio
# Docker image to pull (registry/name, without tag). Defaults to the open image.
# Custom/closed builds override this, e.g. STUDIO_IMAGE=ghcr.io/pengpoom/poomimage
STUDIO_IMAGE=ghcr.io/pengpoom/poompoom
IMAGE_TAG=latest
IMAGE_STUDIO_DEPLOY_DIR=/root/image-studio
IMAGE_STUDIO_DATA_DIR=./backend/data
POSTGRES_DB=image_studio
POSTGRES_USER=image_studio
POSTGRES_PASSWORD=change-this-database-password-61c9a0d4
POSTGRES_PORT=5432
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_SECONDS=300
JOB_QUEUE_BACKEND=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=imagestudio:studio
REDIS_PORT=6379

# Required for web one-click Docker updates. Use a long random value in production.
IMAGE_STUDIO_UPDATER_TOKEN=change-this-updater-token-8c7f6e2a
IMAGE_STUDIO_UPDATE_TIMEOUT_SECONDS=900
DOCKER_CONFIG_DIR=/root/.docker
IMAGE_STUDIO_VERSION_REPO=your-org/image-studio
# Optional. Required for private repositories when checking GitHub releases/tags.
IMAGE_STUDIO_GITHUB_TOKEN=

# Optional. Required only when enabling email verification registration in system settings.
REGISTRATION_SMTP_HOST=
REGISTRATION_SMTP_PORT=587
REGISTRATION_SMTP_USERNAME=
REGISTRATION_SMTP_PASSWORD=
REGISTRATION_SMTP_FROM=
REGISTRATION_SMTP_FROM_NAME=Poom Studio

# External image distribution API (/v1/images/*). Enabled by default; set false to disable exposure.
EXTERNAL_API_ENABLED=true
# Public domain end users put into their client base_url, e.g. https://your-domain.com
EXTERNAL_API_BASE_URL=
# HMAC root secret for API keys; generate with `openssl rand -hex 32`. The deploy script seeds one on first run.
# WARNING: never change this once any key is issued — all existing keys break immediately and must be re-issued.
# Carry the same value across server migrations.
EXTERNAL_API_SIGNING_SECRET=
EXTERNAL_API_DEFAULT_RATE_LIMIT_PER_MINUTE=60
EXTERNAL_API_DEFAULT_CONCURRENCY_LIMIT=2
